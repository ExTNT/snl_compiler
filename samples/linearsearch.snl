program linearsearch
    var array[0..8] of integer a;
        integer target; integer i; integer found;
begin
    a[0] := 7; a[1] := 3; a[2] := 9; a[3] := 2; a[4] := 8;
    a[5] := 5; a[6] := 1; a[7] := 6; a[8] := 4;
    target := 5;
    i := 0;
    found := 0;
    while found = 0 do
        if a[i] = target then
            found := 1
        else
            i := i + 1
        fi;
        if i = 9 then
            found := 2
        else
            found := found
        fi
    endwh;
    if found = 1 then
        write(target);
        write(i)
    else
        i := i
    fi
end.

program dpcoin
    var array[0..3] of integer coins;
        array[0..15] of integer dp;
        integer amount; integer m;
        integer i; integer j; integer val; integer best;
begin
    coins[0] := 1; coins[1] := 3; coins[2] := 4; coins[3] := 7;
    amount := 15;
    m := 4;
    dp[0] := 0;
    i := 1;
    while i < amount + 1 do
        dp[i] := 999;
        i := i + 1
    endwh;
    i := 1;
    while i < amount + 1 do
        best := 999;
        j := 0;
        while j < m do
            if coins[j] < i + 1 then
                val := dp[i - coins[j]] + 1;
                if val < best then
                    best := val
                else
                    val := val
                fi
            else
                val := val
            fi;
            if coins[j] = i then
                best := 1
            else
                best := best
            fi;
            j := j + 1
        endwh;
        dp[i] := best;
        i := i + 1
    endwh;
    write(amount);
    write(dp[amount])
end.

program selection
    var array[0..4] of integer a;
        integer n; integer i; integer j; integer minIdx; integer temp;
begin
    a[0] := 64; a[1] := 34; a[2] := 25; a[3] := 12; a[4] := 22;
    n := 5;
    i := 0;
    while i < (n - 1) do
        minIdx := i;
        j := i + 1;
        while j < n do
            if a[j] < a[minIdx] then
                minIdx := j
            else
                temp := 0
            fi;
            j := j + 1
        endwh;
        temp := a[minIdx];
        a[minIdx] := a[i];
        a[i] := temp;
        i := i + 1
    endwh;
    i := 0;
    while i < n do
        write(a[i]);
        i := i + 1
    endwh
end.

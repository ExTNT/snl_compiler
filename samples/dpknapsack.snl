program dpknapsack
    var array[0..4] of integer wt;
        array[0..4] of integer val;
        array[0..10] of integer dp;
        integer n; integer cap;
        integer i; integer w; integer take; integer skip;
begin
    wt[0] := 2; wt[1] := 3; wt[2] := 4; wt[3] := 5; wt[4] := 1;
    val[0] := 3; val[1] := 4; val[2] := 5; val[3] := 8; val[4] := 1;
    n := 5;
    cap := 10;
    w := 0;
    while w < cap + 1 do
        dp[w] := 0;
        w := w + 1
    endwh;
    i := 0;
    while i < n do
        w := cap;
        while 0 < w do
            if wt[i] < w + 1 then
                take := dp[w - wt[i]] + val[i];
                skip := dp[w];
                if skip < take then
                    dp[w] := take
                else
                    take := take
                fi
            else
                take := take
            fi;
            if wt[i] = w then
                take := val[i];
                skip := dp[w];
                if skip < take then
                    dp[w] := take
                else
                    take := take
                fi
            else
                take := take
            fi;
            w := w - 1
        endwh;
        i := i + 1
    endwh;
    write(cap);
    write(dp[cap])
end.

program insertion
    var array[0..4] of integer a;
        integer n; integer i; integer key; integer j;
        integer ipos; integer done;
begin
    a[0] := 64; a[1] := 34; a[2] := 25; a[3] := 12; a[4] := 22;
    n := 5;
    i := 1;
    while i < n do
        key := a[i];
        j := i;
        ipos := i;
        done := 0;
        while done = 0 do
            if j = 0 then
                ipos := 0;
                done := 1
            else
                if a[j - 1] < key then
                    ipos := j;
                    done := 1
                else
                    a[j] := a[j - 1];
                    j := j - 1
                fi
            fi
        endwh;
        a[ipos] := key;
        i := i + 1
    endwh;
    i := 0;
    while i < n do
        write(a[i]);
        i := i + 1
    endwh
end.

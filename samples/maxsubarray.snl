program maxsubarray
    var array[0..8] of integer a;
        integer n; integer i;
        integer curlen; integer maxlen;
begin
    a[0] := 1; a[1] := 3; a[2] := 5; a[3] := 2; a[4] := 4;
    a[5] := 6; a[6] := 8; a[7] := 1; a[8] := 9;
    n := 9;
    curlen := 1;
    maxlen := 1;
    i := 1;
    while i < n do
        if a[i - 1] < a[i] then
            curlen := curlen + 1
        else
            curlen := 1
        fi;
        if maxlen < curlen then
            maxlen := curlen
        else
            curlen := curlen
        fi;
        i := i + 1
    endwh;
    write(maxlen)
end.
